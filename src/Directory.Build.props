<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <Authors>The Neo Project</Authors>
        <Company>The Neo Project</Company>
        <Copyright>2015-2026 The Neo Project</Copyright>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PackageIcon>neo-logo-72.png</PackageIcon>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/neo-project/neo-express</PackageProjectUrl>
        <PackageTags>Neo;Blockchain;Smart Contract</PackageTags>
        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://github.com/neo-project/neo-express.git</RepositoryUrl>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <ApplicationIcon>../neo-cli.ico</ApplicationIcon>
    </PropertyGroup>
    <PropertyGroup>
        <!-- Neo core packages (neo-project/neo). -->
        <NeoVersion>3.11.2</NeoVersion>
        <!-- Neo module packages (neo-project/neo-modules). Kept at 3.10.2 until matching 3.11.x packages are published. -->
        <NeoModuleVersion>3.10.2</NeoModuleVersion>
        <!-- Neo.Consensus.DBFT (neo-project/neo-node). Pinned at 3.10.1 because 3.10.2 depends on Neo.ConsoleService 3.10.2,
             which is unpublished on NuGet.org and not vendored in deps/; see changelog for the 3.10.1 release. -->
        <NeoConsensusDbftVersion>3.10.1</NeoConsensusDbftVersion>
        <!-- Neo.Plugins.RpcServer (neo-project/neo-node). Decoupled from NeoVersion because neo-node has not published
             a 3.11.x RpcServer package yet; 3.10.2 remains the latest. -->
        <NeoRpcServerVersion>3.10.2</NeoRpcServerVersion>
    </PropertyGroup>
    <ItemGroup>
        <None Include="../neo-logo-72.png" Pack="true" Visible="false" PackagePath=""/>
    </ItemGroup>
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
</Project>
